{
  "name": "waddup",
  "version": "0.1.0",
  "description": "A small WhatsApp chat client for the terminal (unofficial, built on Baileys)",
  "private": true,
  "type": "module",
  "main": "chat.js",
  "bin": {
    "waddup": "chat.js"
  },
  "scripts": {
    "start": "node chat.js",
    "line": "node chat.js --line"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2"
  },
  "allowScripts": {
    "@whiskeysockets/baileys@7.0.0-rc14": true,
    "qrcode-terminal@0.12.0": true,
    "protobufjs@7.6.6": true
  }
}
